# =============================================================================
# Employee Onboarding System — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Database ---
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5433/onboarding_db?schema=public"

# Docker Compose postgres container credentials (must match DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_DB=onboarding_db

# --- Authentication ---
# JWT secret — use a strong random string (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<your-jwt-secret-min-32-chars>

# --- Document Encryption (Local Vault) ---
# AES-256 encryption key for locally stored document files
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=<your-vault-encryption-key-min-32-chars>

# --- OCR ---
# OCR_MODE controls document extraction mode:
#   mistral  (default / production): calls Mistral OCR API — requires MISTRAL_API_KEY
#   local    (development): reads from prisma/seed-data/ocr/<TYPE>.json
OCR_MODE=local
MISTRAL_API_KEY=<your-mistral-api-key>

# --- Storage ---
# STORAGE_PROVIDER controls where uploaded documents are stored:
#   local    (default): encrypted files stored under uploads/ — no external credentials needed
#   supabase: stores in Supabase Storage — requires SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
STORAGE_PROVIDER=local
SUPABASE_URL=<your-supabase-project-url>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# --- Email ---
# Leave BREVO_API_KEY blank/unset to run in log-to-console mode (dev-friendly).
# Set a real key to enable transactional email delivery via Brevo.
BREVO_API_KEY=<your-brevo-api-key>

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002"

# --- Seed (optional) ---
# Password used for seeded dev users (only used by `prisma db seed`)
# Default if unset: a randomly generated one printed to console at seed time
SEED_DEV_PASSWORD=<optional-dev-seed-password>

# Invitation code created by the seed script
SEED_INVITATION_CODE=WELCOME2026
