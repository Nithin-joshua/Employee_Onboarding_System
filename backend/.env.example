# =============================================================================
# Employee Onboarding System — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://postgres:testpass123@localhost:5433/onboarding_db?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=testpass123
POSTGRES_DB=onboarding_db

# --- Authentication (JWT) ---
# Secret for signing access tokens (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars_here

# --- Document Encryption (Local Vault) ---
# 32-byte AES-256 key (64 hex characters) for encrypting local documents
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# --- OCR Document Extraction ---
# OCR_MODE: 'google' (Free / Recommended), 'mistral' (Cloud Paid), or 'local' (Mock)
OCR_MODE=google
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Storage ---
# STORAGE_PROVIDER: 'local' (encrypted on disk) or 'supabase' (bucket 'employee_documents')
STORAGE_PROVIDER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# --- Email (Brevo) ---
# Leave BREVO_API_KEY empty to log emails to console in development
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_brevo_email@example.com

# --- CORS ---
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002"

# --- Seed (optional) ---
SEED_DEV_PASSWORD=SeedPass123!
SEED_INVITATION_CODE=WELCOME2026
