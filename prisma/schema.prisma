datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

enum EmployeeStatus {
  REGISTERED
  INVITED
  DOCUMENTS_PENDING
  DOCUMENTS_SUBMITTED
  UNDER_REVIEW
  MANAGER_REVIEW
  COMPLIANCE_PROCESSING
  PENDING_SIGNATURE
  DAY1_READY
  ACTIVE
  MILESTONE_30
  MILESTONE_60
  MILESTONE_90
  ONBOARDING_COMPLETE
}

enum DocumentType {
  AADHAAR
  PAN
  EDUCATION
  RELIEVING_LETTER
  BANK_PROOF
  PHOTO
}

enum DocumentStatus {
  PENDING
  SUBMITTED
  EXTRACTED
  VERIFIED
  REJECTED
}

enum ComplianceFormType {
  PF_FORM11
  PF_FORM2
  ESI_FORM1
}

enum ComplianceFormStatus {
  NOT_APPLICABLE
  PENDING_GENERATION
  PENDING_SIGNATURE
  SIGNED
}

enum MilestoneType {
  DAY1
  M30 @map("30")
  M60 @map("60")
  M90 @map("90")
}

enum MilestoneStatus {
  PENDING
  DONE
}

enum AsyncJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum Role {
  HR
  MANAGER
  NEW_HIRE
  SYSTEM
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  employeeId   String?  @unique
  createdAt    DateTime @default(now())
}

model Employee {
  id              String           @id
  status          EmployeeStatus
  personal        Json
  job             Json
  lastRejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  documents       Document[]
  complianceForms ComplianceForm[]
  milestones      Milestone[]
}

model Document {
  id              String         @id
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type            DocumentType
  status          DocumentStatus
  extracted       Json?
  reviewedBy      String?
  rejectionReason String?
  storagePath     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([employeeId])
  @@index([status])
}

model ComplianceForm {
  id         String               @id
  employeeId String
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       ComplianceFormType
  status     ComplianceFormStatus
  deadline   DateTime
  data       Json
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([employeeId, type])
  @@index([employeeId])
}

model Milestone {
  id         String          @id
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       MilestoneType
  status     MilestoneStatus
  dueDate    DateTime
  checklist  Json
}

model InvitationCode {
  id          String   @id @default(uuid())
  code        String   @unique
  jobTitle    String
  department  String
  managerId   String
  salary      Int
  joiningDate DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)

  @@index([userId])
}

model AuditLog {
  id           String         @id @default(uuid())
  employeeId   String
  fromStatus   EmployeeStatus
  toStatus     EmployeeStatus
  actorId      String
  actorRole    Role
  timestamp    DateTime       @default(now())
  note         String?
  previousHash String         @default("0")
  currentHash  String

  @@index([employeeId])
}

model ComplianceRule {
  id          String   @id @default(uuid())
  ruleKey     String   @unique
  ruleName    String
  threshold   Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AsyncJob {
  id        String         @id @default(uuid())
  type      String
  payload   Json
  status    AsyncJobStatus
  attempts  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
}

model OutboxEvent {
  id        String   @id @default(uuid())
  eventType String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}
