# =============================================================================
# Employee Onboarding System — Environment Configuration Template
# =============================================================================
# Copy this file to .env and backend/.env and fill in your values.
# NEVER commit your actual .env file to version control.
# =============================================================================

# --- Database (PostgreSQL & Prisma) ---
# Connection string used by Prisma and NestJS backend (Docker port 5433 by default)
DATABASE_URL="postgresql://postgres:testpass123@localhost:5433/onboarding_db?schema=public"

# Docker Compose PostgreSQL container credentials (must match DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=testpass123
POSTGRES_DB=onboarding_db

# --- Authentication (JWT) ---
# Secret for signing access tokens (minimum 32 characters)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_characters_here

# --- Document Encryption (Local Vault) ---
# 32-byte AES-256 encryption key (64 hex characters) used to encrypt files in local mode
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# --- OCR Document Extraction ---
# OCR_MODE controls extraction provider:
#   google   (Free / Recommended): uses Google Gemini Vision API (requires GOOGLE_API_KEY)
#   mistral  (Paid Cloud): calls Mistral OCR API (requires MISTRAL_API_KEY and STORAGE_PROVIDER=supabase)
#   local    (Offline Mock): reads pre-extracted fixtures from prisma/seed-data/ocr/
OCR_MODE=google
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_API_KEY=your_mistral_api_key_here

# --- File Storage ---
# STORAGE_PROVIDER controls where uploaded documents are stored:
#   local    (default): encrypted files stored on local disk under uploads/
#   supabase : uploaded to Supabase Storage bucket 'employee_documents'
STORAGE_PROVIDER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# --- Email Service (Brevo Transactional) ---
# Leave BREVO_API_KEY empty to run in local console-log mode (prints OTPs to terminal)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_brevo_email@example.com

# --- CORS & Origins ---
# Allowed frontend origins (comma-separated)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002"

# --- Seed Configuration ---
# Password used for seeded dev users (hr@example.com, manager@example.com, etc.)
SEED_DEV_PASSWORD=SeedPass123!
SEED_INVITATION_CODE=WELCOME2026

# --- Frontend NextAuth Configuration ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
