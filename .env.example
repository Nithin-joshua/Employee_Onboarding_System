# Database URL for Prisma to connect to Postgres
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/onboarding_db?schema=public"

# JWT Token Secret for NestJS AuthModule
JWT_SECRET="dev-secret-key-change-me-in-production-12345678"

# NextAuth Secret for frontend session management
NEXTAUTH_SECRET="devauthsecretchange-me-in-production-123456"

# OCR configuration (use 'mock' to load from fixtures offline)
OCR_MODE="mock"
MISTRAL_API_KEY="mock_mistral_key_for_dev"

# Supabase Storage configuration
SUPABASE_URL="https://mockprojecturl.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="mock_service_role_key"
STORAGE_PROVIDER="local" # Options: 'local', 'supabase'

# Brevo transactional email sender (optional, logs to console if mock/invalid)
BREVO_API_KEY="mock_brevo_api_key_for_testing"

# AES Vault Encryption Key
VAULT_ENCRYPTION_KEY="default-secret-key-change-me-in-production-12345"

# CORS Allowed Origins (comma-separated list)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
